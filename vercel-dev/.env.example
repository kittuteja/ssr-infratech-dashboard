# Local development only. Vercel requires a remote libsql:// or https:// URL.
TURSO_DATABASE_URL=file:.sites-runtime/vercel-development.sqlite
TURSO_AUTH_TOKEN=
# Generate with npm run setup:key. Remove from Vercel after first admin setup.
OWNER_SETUP_KEY=
# Leave empty normally. Set a new, different key only for owner recovery.
OWNER_RECOVERY_KEY=
