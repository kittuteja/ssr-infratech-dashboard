{
  "name": "ssr-infratech-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "vercel-build": "node scripts/migrate.mjs && node scripts/build.mjs",
    "setup:key": "node scripts/setup-key.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12"
  }
}
